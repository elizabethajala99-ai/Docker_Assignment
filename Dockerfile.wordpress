FROM wordpress:apache

# Install WP-CLI and dependencies
RUN apt-get update && \
    apt-get install -y mysql-client curl && \
    curl -O https://raw.githubusercontent.com/wp-cli/wp-cli/v2.8.1/wp-cli.phar && \
    chmod +x wp-cli.phar && \
    mv wp-cli.phar /usr/local/bin/wp && \
    rm -rf /var/lib/apt/lists/*

# Copy initialization script
COPY init-wordpress.sh /usr/local/bin/init-wordpress.sh
RUN chmod +x /usr/local/bin/init-wordpress.sh

# Copy custom theme
COPY wordpress-content/ /tmp/wordpress-content/

# Create startup script
RUN echo '#!/bin/bash\n\
# Start Apache in background\n\
apache2-foreground &\n\
\n\
# Wait for WordPress to be ready\n\
echo "Waiting for WordPress to initialize..."\n\
sleep 15\n\
\n\
# Copy theme if not already present\n\
if [ ! -d "/var/www/html/wp-content/themes/cloudboosta" ]; then\n\
    cp -r /tmp/wordpress-content/* /var/www/html/wp-content/\n\
    chown -R www-data:www-data /var/www/html/wp-content/\n\
fi\n\
\n\
# Run WordPress setup\n\
/usr/local/bin/init-wordpress.sh &\n\
\n\
# Keep Apache running\n\
wait' > /usr/local/bin/start-wordpress.sh && \
chmod +x /usr/local/bin/start-wordpress.sh

CMD ["/usr/local/bin/start-wordpress.sh"]